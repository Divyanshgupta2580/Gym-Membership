<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found | GYMFLOW</title>
  <link rel="stylesheet" href="/public/css/variables.css">
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/components.css">
  <style>
    .error-wrapper {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-6);
      text-align: center;
    }
    .error-code {
      font-size: 5rem;
      font-weight: 800;
      letter-spacing: -0.05em;
      color: var(--accent-primary);
      line-height: 1;
    }
  </style>
</head>
<body>
  <div class="error-wrapper">
    <div class="card" style="max-width: 480px; width: 100%; padding: var(--space-8);">
      <div class="error-code">404</div>
      <h2 style="margin: var(--space-3) 0 var(--space-2);">Resource Not Found</h2>
      <p style="font-size: var(--font-size-sm); color: var(--text-secondary); margin-bottom: var(--space-6);">
        The requested URL <code><%= typeof path !== 'undefined' ? path : '' %></code> was not found on this server.
      </p>
      <div class="flex justify-center gap-3">
        <a href="/" class="btn btn-primary btn-md">Return Home</a>
        <a href="/auth/login" class="btn btn-secondary btn-md">Sign In</a>
      </div>
    </div>
  </div>
</body>
</html>
