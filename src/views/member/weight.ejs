<div class="flex flex-col gap-6">
  <!-- Top Grid: Weight Logger & Trend Metrics -->
  <div class="grid grid-cols-3 gap-6">
    <!-- Weight Logger Form (2 cols) -->
    <div class="card" style="grid-column: span 2;">
      <div class="card-header">
        <div>
          <div class="card-title">Log Body Weight</div>
          <div class="card-subtitle">Track your weight over time to monitor fitness progress</div>
        </div>
      </div>
      <div class="card-body">
        <form action="/member/weight/log" method="POST" class="grid grid-cols-3 gap-3 items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group" style="margin: 0;">
            <label for="weightInput" class="form-label">Weight Value</label>
            <input type="number" step="0.1" min="20" max="500" name="weight" id="weightInput" class="form-input" placeholder="e.g. 75.5" required>
          </div>

          <div class="form-group" style="margin: 0;">
            <label for="unitInput" class="form-label">Unit</label>
            <select name="unit" id="unitInput" class="form-select">
              <option value="kg" selected>Kilograms (kg)</option>
              <option value="lbs">Pounds (lbs)</option>
            </select>
          </div>

          <div class="form-group" style="margin: 0;">
            <label for="weightDate" class="form-label">Date</label>
            <input type="date" name="date" id="weightDate" class="form-input" value="<%= formatDateString(new Date()) %>" max="<%= formatDateString(new Date()) %>" required>
          </div>

          <div class="form-group" style="margin: 0; grid-column: span 2;">
            <label for="weightNotes" class="form-label">Notes (Optional)</label>
            <input type="text" name="notes" id="weightNotes" class="form-input" placeholder="e.g. Morning fasted weigh-in">
          </div>

          <button type="submit" class="btn btn-primary btn-md">Save Weight Log</button>
        </form>
      </div>
    </div>

    <!-- Trend Intelligence Card (1 col) -->
    <div class="card">
      <div class="card-header">
        <div class="card-title">Weight Trajectory</div>
      </div>
      <div class="card-body flex flex-col justify-center">
        <% if (weightTrend && weightTrend.hasData) { %>
          <div class="stat-label">Net Shift</div>
          <div class="stat-value" style="color: var(--accent-blue);">
            <%= weightTrend.netChange > 0 ? `+${weightTrend.netChange}` : weightTrend.netChange %> <%= weightTrend.unit %>
          </div>
          <div style="margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px solid var(--border-subtle); font-size: var(--font-size-xs); color: var(--text-secondary); display: flex; flex-direction: column; gap: 4px;">
            <div>Starting Log: <strong><%= weightTrend.firstWeight %> <%= weightTrend.unit %></strong></div>
            <div>Latest Log: <strong><%= weightTrend.latestWeight %> <%= weightTrend.unit %></strong></div>
            <div>Rate: <strong><%= weightTrend.ratePerWeek %> <%= weightTrend.unit %>/week</strong></div>
            <div>Trajectory: <span class="badge badge-active" style="text-transform: capitalize;"><%= weightTrend.trajectory %></span></div>
          </div>
        <% } else { %>
          <div class="empty-state" style="padding: var(--space-4);">
            <div class="empty-state-title">No Weight Data</div>
            <div class="empty-state-desc">Record at least two weight entries to generate trajectory and rate analysis.</div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Historical Line Chart -->
  <div class="card">
    <div class="card-header">
      <div>
        <div class="card-title">Weight Progression Chart</div>
        <div class="card-subtitle">Visual timeline of recorded weigh-ins</div>
      </div>
    </div>
    <div class="card-body" style="height: 300px;">
      <canvas id="weightHistoryChart"></canvas>
    </div>
  </div>

  <!-- Historical Weight Logs Table -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">Recorded Weight Ledger</div>
    </div>
    <div class="table-container" style="border: none; border-radius: 0;">
      <table class="data-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Weight</th>
            <th>Notes</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (weightLogs && weightLogs.length > 0) { %>
            <% weightLogs.forEach(w => { %>
              <tr>
                <td style="font-weight: 600;"><%= w.dateString %></td>
                <td style="font-weight: 700; color: var(--accent-blue);"><%= w.weight %> <%= w.unit %></td>
                <td style="font-size: var(--font-size-xs); color: var(--text-muted);"><%= w.notes || 'Normal entry' %></td>
                <td style="text-align: right;">
                  <form action="/member/weight/<%= w._id %>/delete" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('Delete this weight entry?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-outline btn-sm" style="color: var(--accent-rose);">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" style="text-align: center; color: var(--text-muted); padding: var(--space-8);">
                No weight logs recorded yet. Enter your first weigh-in above.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const logs = <%- JSON.stringify(weightLogs ? [...weightLogs].reverse() : []) %>;
    if (window.GymflowCharts && logs.length > 0) {
      window.GymflowCharts.renderWeightProgress('weightHistoryChart', logs, logs[0]?.unit || 'kg');
    }
  });
</script>
