<div class="flex flex-col gap-6" style="max-width: 720px; margin: 0 auto; width: 100%;">
  <div class="card">
    <div class="card-header">
      <div>
        <div class="badge badge-role-member" style="margin-bottom: var(--space-2); display: inline-block;">Demo Plan Preview</div>
        <h2 style="font-size: var(--font-size-2xl); font-weight: 800;"><%= plan.name %></h2>
        <p class="card-subtitle"><%= plan.description %></p>
      </div>
      <a href="/member/membership" class="btn btn-outline btn-sm">Back to Plans</a>
    </div>

    <div class="card-body">
      <div style="border-bottom: 1px solid var(--border-subtle); padding-bottom: var(--space-4); margin-bottom: var(--space-6);">
        <div class="stat-label">Access Duration & Pricing</div>
        <div style="font-size: var(--font-size-3xl); font-weight: 800; color: var(--accent-primary); margin-top: 4px;">
          $<%= plan.price %> <span style="font-size: var(--font-size-sm); color: var(--text-muted); font-weight: 400;">/ <%= plan.durationInDays %> days (<%= plan.durationMonths %> months)</span>
        </div>
      </div>

      <div style="margin-bottom: var(--space-6);">
        <div class="stat-label" style="margin-bottom: var(--space-3);">Included Plan Benefits</div>
        <ul class="flex flex-col gap-3" style="font-size: var(--font-size-sm); color: var(--text-secondary);">
          <% if (plan.features && plan.features.length > 0) { %>
            <% plan.features.forEach(f => { %>
              <li class="flex items-center gap-2">
                <svg style="width: 16px; height: 16px; color: var(--accent-primary); flex-shrink: 0;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span><%= f %></span>
              </li>
            <% }) %>
          <% } else { %>
            <li class="flex items-center gap-2">
              <span style="color: var(--accent-primary); font-weight: 700;">&check;</span>
              <span>Full facility access and workout tracking</span>
            </li>
          <% } %>
        </ul>
      </div>

      <div style="padding: var(--space-4); border-radius: var(--radius-md); background-color: var(--bg-secondary); border: 1px solid var(--border-subtle); margin-bottom: var(--space-6);">
        <div style="font-weight: 700; font-size: var(--font-size-sm); color: var(--text-primary); margin-bottom: 4px;">Demo Selection Notice</div>
        <div style="font-size: var(--font-size-xs); color: var(--text-muted); line-height: 1.5;">
          Selecting this plan will update your active membership tier in demo preview mode. No payment will be processed and no real credit card is required.
        </div>
      </div>

      <form action="/member/membership/select-demo" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="planId" value="<%= plan._id %>">
        <button type="submit" class="btn btn-primary btn-lg btn-block">
          Activate Demo Preview (<%= plan.name %>)
        </button>
      </form>
    </div>
  </div>
</div>
