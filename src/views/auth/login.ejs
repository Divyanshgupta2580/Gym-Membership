<div class="card">
  <div class="card-header">
    <div>
      <h2 class="card-title">Sign In</h2>
      <p class="card-subtitle">Enter your credentials to access your GYMFLOW account</p>
    </div>
  </div>

  <div class="card-body">
    <form action="/auth/login" method="POST" id="loginForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="returnTo" value="<%= returnTo %>">

      <div class="form-group">
        <label for="email" class="form-label">Email Address</label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-input"
          placeholder="name@example.com"
          required
          autocomplete="email"
        >
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          class="form-input"
          placeholder="Enter your password"
          required
          autocomplete="current-password"
        >
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: var(--space-2);">
        Sign In
      </button>
    </form>

    <div style="margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--border-subtle);">
      <div class="form-label" style="text-align: center; margin-bottom: var(--space-3);">
        Quick Demo Access (Click to autofill)
      </div>
      <div class="grid grid-cols-3 gap-2">
        <button
          type="button"
          class="btn btn-secondary btn-sm demo-fill-btn"
          data-email="admin@gymflow.test"
          data-pass="Password123!"
        >
          Admin
        </button>
        <button
          type="button"
          class="btn btn-secondary btn-sm demo-fill-btn"
          data-email="marcus.trainer@gymflow.test"
          data-pass="Password123!"
        >
          Trainer
        </button>
        <button
          type="button"
          class="btn btn-secondary btn-sm demo-fill-btn"
          data-email="alex.member@gymflow.test"
          data-pass="Password123!"
        >
          Member
        </button>
      </div>
    </div>
  </div>

  <div class="card-footer" style="justify-content: center; font-size: var(--font-size-sm);">
    <span>Do not have an account?</span>
    <a href="/auth/register" style="font-weight: 600;">Register as a Member</a>
  </div>
</div>

<script>
  document.querySelectorAll('.demo-fill-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('email').value = btn.getAttribute('data-email');
      document.getElementById('password').value = btn.getAttribute('data-pass');
    });
  });
</script>
