<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="GYMFLOW Authentication Portal">
  <title><%= typeof title !== 'undefined' ? `${title} | GYMFLOW` : 'Sign In | GYMFLOW' %></title>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  
  <link rel="stylesheet" href="/public/css/variables.css">
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/components.css">
  <style>
    .auth-wrapper {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-6);
      background: radial-gradient(circle at top center, #172033 0%, #0a0e17 70%);
    }
    .auth-box {
      width: 100%;
      max-width: 440px;
    }
    .auth-brand {
      text-align: center;
      margin-bottom: var(--space-6);
    }
    .auth-brand .brand-logo {
      margin: 0 auto var(--space-3);
      width: 44px;
      height: 44px;
      font-size: var(--font-size-xl);
    }
    .auth-brand .brand-text {
      font-size: var(--font-size-2xl);
    }
  </style>
</head>
<body>
  <div class="auth-wrapper">
    <div class="auth-box">
      <div class="auth-brand">
        <div class="brand-logo">G</div>
        <div class="brand-text">GYMFLOW</div>
        <p class="brand-subtext" style="letter-spacing: 0.15em; margin-top: 4px;">Fitness Intelligence Platform</p>
      </div>

      <%- include('../partials/flash') %>
      <%- body %>
    </div>
  </div>

  <script src="/public/js/main.js"></script>
</body>
</html>
