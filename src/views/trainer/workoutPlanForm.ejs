<div class="flex flex-col gap-6">
  <div class="card">
    <div class="card-header">
      <div>
        <h2>Weekly Workout Routine Builder</h2>
        <p class="card-subtitle">Prescribing a 7-day structured training program for <strong><%= member.firstName %> <%= member.lastName %></strong></p>
      </div>
    </div>

    <form action="/trainer/plans/create" method="POST" id="workoutPlanForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="memberId" value="<%= member._id %>">
      <input type="hidden" name="scheduleJson" id="scheduleJson">

      <div class="card-body">
        <div class="grid grid-cols-2 gap-4">
          <div class="form-group">
            <label for="planName" class="form-label">Routine Name</label>
            <input type="text" name="name" id="planName" class="form-input" placeholder="e.g. 4-Day Hypertrophy & Core Split" required>
          </div>

          <div class="form-group">
            <label for="difficulty" class="form-label">Difficulty Level</label>
            <select name="difficulty" id="difficulty" class="form-select">
              <% difficultyLevels.forEach(lvl => { %>
                <option value="<%= lvl %>"><%= lvl %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="description" class="form-label">Program Overview / Trainer Instructions</label>
          <textarea name="description" id="description" class="form-textarea" rows="2" placeholder="Focus on controlled eccentrics and progressive overload. Ensure 2L hydration daily."></textarea>
        </div>

        <div style="margin: var(--space-6) 0 var(--space-4);">
          <h3>7-Day Schedule Definition</h3>
          <p style="font-size: var(--font-size-xs); color: var(--text-muted);">Configure daily target focus or assign rest days. Add specific exercises with sets and repetitions.</p>
        </div>

        <div class="flex flex-col gap-4" id="daysContainer">
          <% daysOfWeek.forEach((day, index) => { %>
            <div class="card day-card" data-day="<%= day %>" style="background-color: var(--bg-secondary); border: 1px solid var(--border-muted);">
              <div class="card-header" style="padding: var(--space-3) var(--space-4);">
                <div class="flex items-center gap-3">
                  <span style="font-weight: 700; color: var(--text-primary);"><%= day %></span>
                  <label class="flex items-center gap-2" style="font-size: var(--font-size-xs); cursor: pointer;">
                    <input type="checkbox" class="rest-toggle" data-day-index="<%= index %>">
                    <span>Rest Day</span>
                  </label>
                </div>
                <div class="flex items-center gap-2 day-focus-group">
                  <span style="font-size: var(--font-size-xs); color: var(--text-muted);">Focus:</span>
                  <input type="text" class="form-input day-focus-input" placeholder="e.g. <%= index % 2 === 0 ? 'Upper Body Push' : 'Active Recovery' %>" style="width: 220px; padding: 4px 8px; font-size: var(--font-size-xs);">
                </div>
              </div>

              <div class="card-body day-exercises-body" style="padding: var(--space-4);">
                <div class="exercise-rows-container flex flex-col gap-2" data-day-index="<%= index %>">
                  <!-- Exercise rows inserted dynamically -->
                </div>
                <button type="button" class="btn btn-secondary btn-sm add-exercise-btn" data-day-index="<%= index %>" style="margin-top: var(--space-2);">
                  + Add Exercise
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="card-footer">
        <a href="/trainer/clients/<%= member._id %>" class="btn btn-secondary btn-sm">Cancel</a>
        <button type="submit" class="btn btn-primary btn-sm">Save & Assign Workout Routine</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const days = <%- JSON.stringify(daysOfWeek) %>;

    // Helper to generate exercise row HTML
    function createExerciseRowHtml() {
      return `
        <div class="exercise-row grid grid-cols-4 gap-2 items-center" style="background-color: var(--bg-input); padding: 8px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
          <input type="text" class="form-input ex-name" placeholder="Exercise Name" required style="font-size: var(--font-size-xs); padding: 4px 8px;">
          <div class="flex gap-1">
            <input type="number" class="form-input ex-sets" placeholder="Sets" min="1" value="3" required style="font-size: var(--font-size-xs); padding: 4px 8px; width: 65px;">
            <input type="text" class="form-input ex-reps" placeholder="Reps (e.g. 10-12)" value="10-12" required style="font-size: var(--font-size-xs); padding: 4px 8px;">
          </div>
          <div class="flex gap-1">
            <input type="number" class="form-input ex-rest" placeholder="Rest (s)" min="0" value="60" style="font-size: var(--font-size-xs); padding: 4px 8px; width: 75px;">
            <input type="text" class="form-input ex-notes" placeholder="Notes (optional)" style="font-size: var(--font-size-xs); padding: 4px 8px;">
          </div>
          <div style="text-align: right;">
            <button type="button" class="btn btn-danger btn-sm remove-ex-btn" style="padding: 4px 8px; font-size: var(--font-size-xs);">&times;</button>
          </div>
        </div>
      `;
    }

    // Add exercise button handler
    document.querySelectorAll('.add-exercise-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = btn.getAttribute('data-day-index');
        const container = document.querySelector(`.exercise-rows-container[data-day-index="${idx}"]`);
        if (container) {
          container.insertAdjacentHTML('beforeend', createExerciseRowHtml());
          attachRemoveListeners();
        }
      });
    });

    // Remove exercise button handler
    function attachRemoveListeners() {
      document.querySelectorAll('.remove-ex-btn').forEach(btn => {
        btn.onclick = () => {
          btn.closest('.exercise-row').remove();
        };
      });
    }

    // Rest day toggle handler
    document.querySelectorAll('.rest-toggle').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const card = checkbox.closest('.day-card');
        const body = card.querySelector('.day-exercises-body');
        const focusInput = card.querySelector('.day-focus-input');

        if (checkbox.checked) {
          body.style.display = 'none';
          if (focusInput) focusInput.value = 'Rest & Recovery';
        } else {
          body.style.display = 'block';
          if (focusInput && focusInput.value === 'Rest & Recovery') focusInput.value = '';
        }
      });
    });

    // Pre-populate Monday, Wednesday, Friday with initial exercise rows for convenience
    [0, 2, 4].forEach(idx => {
      const container = document.querySelector(`.exercise-rows-container[data-day-index="${idx}"]`);
      if (container) {
        container.insertAdjacentHTML('beforeend', createExerciseRowHtml());
        container.insertAdjacentHTML('beforeend', createExerciseRowHtml());
      }
    });

    // Tuesday, Thursday, Saturday, Sunday rest defaults
    [1, 3, 5, 6].forEach(idx => {
      const card = document.querySelectorAll('.day-card')[idx];
      if (card && (idx === 6)) { // Set Sunday as rest day
        const toggle = card.querySelector('.rest-toggle');
        if (toggle) {
          toggle.checked = true;
          toggle.dispatchEvent(new Event('change'));
        }
      }
    });

    attachRemoveListeners();

    // Form submission serialization
    const form = document.getElementById('workoutPlanForm');
    form.addEventListener('submit', (e) => {
      const schedule = [];

      document.querySelectorAll('.day-card').forEach((card, idx) => {
        const dayOfWeek = days[idx];
        const isRestDay = card.querySelector('.rest-toggle').checked;
        const focus = card.querySelector('.day-focus-input').value.trim() || (isRestDay ? 'Rest' : 'Workout');
        const exercises = [];

        if (!isRestDay) {
          card.querySelectorAll('.exercise-row').forEach((row, order) => {
            const name = row.querySelector('.ex-name').value.trim();
            const sets = parseInt(row.querySelector('.ex-sets').value, 10) || 3;
            const reps = row.querySelector('.ex-reps').value.trim() || '10';
            const restSeconds = parseInt(row.querySelector('.ex-rest').value, 10) || 60;
            const notes = row.querySelector('.ex-notes').value.trim();

            if (name) {
              exercises.push({ name, sets, reps, restSeconds, notes, order: order + 1 });
            }
          });
        }

        schedule.push({
          dayOfWeek,
          isRestDay,
          focus,
          exercises
        });
      });

      document.getElementById('scheduleJson').value = JSON.stringify(schedule);
    });
  });
</script>
