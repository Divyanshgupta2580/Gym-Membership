<div class="flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <div>
      <h2>Trainer Staff Roster</h2>
      <p style="margin: 0;">Certified coaching team and member client allocation</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm" data-modal-target="createTrainerModal">
      + Add New Trainer
    </button>
  </div>

  <div class="card">
    <div class="table-container" style="border: none; border-radius: 0;">
      <table class="data-table">
        <thead>
          <tr>
            <th>Coach</th>
            <th>Contact</th>
            <th>Specialties</th>
            <th>Assigned Clients</th>
            <th>Status</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (trainers && trainers.length > 0) { %>
            <% trainers.forEach(tr => { %>
              <tr>
                <td>
                  <div style="font-weight: 600;"><%= tr.firstName %> <%= tr.lastName %></div>
                  <div style="font-size: var(--font-size-xs); color: var(--text-muted);">Joined <%= formatDateDisplay(tr.createdAt) %></div>
                </td>
                <td>
                  <div><%= tr.email %></div>
                  <div style="font-size: var(--font-size-xs); color: var(--text-muted);"><%= tr.phone || 'No phone' %></div>
                </td>
                <td>
                  <% if (tr.trainerSpecialties && tr.trainerSpecialties.length > 0) { %>
                    <div class="flex gap-1" style="flex-wrap: wrap;">
                      <% tr.trainerSpecialties.forEach(spec => { %>
                        <span class="badge badge-role-trainer"><%= spec %></span>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <span style="color: var(--text-muted); font-size: var(--font-size-xs);">General Fitness</span>
                  <% } %>
                </td>
                <td>
                  <span class="badge" style="background-color: var(--bg-elevated); color: var(--text-primary);">
                    <%= tr.assignedClientsCount %> client<%= tr.assignedClientsCount === 1 ? '' : 's' %>
                  </span>
                </td>
                <td>
                  <span class="badge <%= tr.isActive ? 'badge-active' : 'badge-inactive' %>">
                    <%= tr.isActive ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td style="text-align: right;">
                  <form action="/admin/users/<%= tr._id %>/toggle-status" method="POST" style="display: inline;" onsubmit="return confirm('Confirm updating active status for this trainer?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-secondary btn-sm">
                      <%= tr.isActive ? 'Deactivate' : 'Activate' %>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" style="text-align: center; color: var(--text-muted); padding: var(--space-8);">
                No trainer accounts registered yet.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Create Trainer Modal -->
<div class="modal-backdrop" id="createTrainerModal">
  <div class="modal-dialog">
    <div class="card-header">
      <div class="card-title">Register New Trainer</div>
      <button type="button" class="alert-close" data-modal-close aria-label="Close modal">&times;</button>
    </div>
    <form action="/admin/trainers/create" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-body">
        <div class="grid grid-cols-2 gap-3">
          <div class="form-group">
            <label for="firstName" class="form-label">First Name</label>
            <input type="text" name="firstName" id="firstName" class="form-input" required>
          </div>
          <div class="form-group">
            <label for="lastName" class="form-label">Last Name</label>
            <input type="text" name="lastName" id="lastName" class="form-input" required>
          </div>
        </div>

        <div class="form-group">
          <label for="trainerEmail" class="form-label">Email Address</label>
          <input type="email" name="email" id="trainerEmail" class="form-input" required>
        </div>

        <div class="form-group">
          <label for="trainerPassword" class="form-label">Initial Password</label>
          <input type="password" name="password" id="trainerPassword" class="form-input" required minlength="6">
        </div>

        <div class="form-group">
          <label for="trainerPhone" class="form-label">Phone Number</label>
          <input type="tel" name="phone" id="trainerPhone" class="form-input">
        </div>

        <div class="form-group">
          <label for="specialties" class="form-label">Specialties (comma-separated)</label>
          <input type="text" name="specialties" id="specialties" class="form-input" placeholder="Hypertrophy, Powerlifting, HIIT, Mobility">
        </div>

        <div class="form-group">
          <label for="bio" class="form-label">Biography / Background</label>
          <textarea name="bio" id="bio" class="form-textarea" rows="2"></textarea>
        </div>
      </div>
      <div class="card-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary btn-sm">Create Trainer Account</button>
      </div>
    </form>
  </div>
</div>
