<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="GYMFLOW: Production Gym Membership, Workout Planning & Fitness Intelligence Platform">
  <title>GYMFLOW - Gym Membership & Fitness Intelligence Platform</title>

  <link rel="stylesheet" href="/public/css/variables.css">
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/components.css">
  <style>
    .hero-section {
      padding: var(--space-12) 0 var(--space-8);
      text-align: center;
      position: relative;
    }
    .hero-tagline {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-full);
      background-color: var(--accent-primary-subtle);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: var(--accent-primary);
      font-size: var(--font-size-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: var(--space-4);
    }
    .hero-title {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      max-width: 840px;
      margin: 0 auto var(--space-4);
      line-height: 1.15;
    }
    .hero-title span {
      background: linear-gradient(135deg, var(--text-primary) 30%, var(--accent-primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-description {
      font-size: var(--font-size-lg);
      max-width: 640px;
      margin: 0 auto var(--space-8);
      color: var(--text-secondary);
    }
    .hero-cta-group {
      display: flex;
      justify-content: center;
      gap: var(--space-4);
      flex-wrap: wrap;
    }
    .feature-card {
      background-color: var(--surface-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: var(--space-8);
      transition: transform var(--transition-speed) ease, border-color var(--transition-speed) ease;
    }
    .feature-card:hover {
      transform: translateY(-4px);
      border-color: var(--border-muted);
    }
    .feature-icon-wrapper {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-lg);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: var(--space-4);
    }
  </style>
</head>
<body>
  <!-- Top Navigation Bar -->
  <header style="height: var(--topbar-height); border-bottom: 1px solid var(--border-subtle); background-color: rgba(10, 14, 23, 0.8); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 50;">
    <div class="container flex items-center justify-between" style="height: 100%;">
      <div class="flex items-center gap-3">
        <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #000; font-weight: 800; font-size: 1.1rem;">G</div>
        <div style="font-size: var(--font-size-lg); font-weight: 700; letter-spacing: -0.03em;">GYMFLOW</div>
      </div>
      <div class="flex items-center gap-4">
        <a href="/auth/login" class="btn btn-outline btn-sm">Sign In</a>
        <a href="/auth/register" class="btn btn-primary btn-sm">Get Started</a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-tagline">
        <span>Production-Grade Fitness Operations</span>
      </div>
      <h1 class="hero-title">
        Run your gym. Track your members. <span>Build stronger routines.</span>
      </h1>
      <p class="hero-description">
        GYMFLOW delivers seamless member management, dynamic trainer workout routines, real-time check-in telemetry, and deterministic fitness intelligence in a unified platform.
      </p>
      <div class="hero-cta-group">
        <a href="/auth/login" class="btn btn-primary btn-lg">Access Platform</a>
        <a href="/auth/register" class="btn btn-secondary btn-lg">Join as Member</a>
      </div>
    </div>
  </section>

  <!-- Feature Pillar Grid -->
  <section style="padding: var(--space-10) 0; border-top: 1px solid var(--border-subtle); background-color: var(--bg-secondary);">
    <div class="container">
      <div style="text-align: center; margin-bottom: var(--space-8);">
        <div class="card-subtitle" style="text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-primary); font-weight: 700;">Platform Architecture</div>
        <h2>Engineered for Gym Owners, Trainers & Athletes</h2>
      </div>

      <div class="grid grid-cols-3 gap-6">
        <div class="feature-card">
          <div class="feature-icon-wrapper" style="background-color: var(--accent-primary-subtle); color: var(--accent-primary);">
            <svg style="width: 24px; height: 24px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3>GYMFLOW Intelligence</h3>
          <p>
            Deterministic rule-based progress analytics. Evaluates attendance consistency, schedule adherence, and body-weight trends without black-box AI or medical claims.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrapper" style="background-color: var(--accent-blue-subtle); color: var(--accent-blue);">
            <svg style="width: 24px; height: 24px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </div>
          <h3>Structured Workout Planning</h3>
          <p>
            Dedicated trainers craft custom 7-day weekly exercise routines with prescribed sets, repetitions, rest intervals, and exercise execution notes.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrapper" style="background-color: var(--accent-purple-subtle); color: var(--accent-purple);">
            <svg style="width: 24px; height: 24px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-2.829a5 5 0 010-7.07m7.072 0a5 5 0 010 7.07M13 12a1 1 0 11-2 0 1 1 0 012 0z"/>
            </svg>
          </div>
          <h3>Live Telemetry via WebSockets</h3>
          <p>
            Instant check-in notifications broadcast securely to authorized administrators and assigned trainers. Real-time gym attendance feeds without page reloads.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Membership Plans Pricing Section -->
  <section style="padding: var(--space-12) 0;">
    <div class="container">
      <div style="text-align: center; margin-bottom: var(--space-8);">
        <div class="card-subtitle" style="text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-primary); font-weight: 700;">Transparent Memberships</div>
        <h2>Choose Your Access Tier</h2>
      </div>

      <div class="grid grid-cols-4 gap-6">
        <% if (typeof plans !== 'undefined' && plans.length > 0) { %>
          <% plans.forEach(plan => { %>
            <div class="card" style="padding: var(--space-6); display: flex; flex-direction: column;">
              <h3 style="font-size: var(--font-size-xl); margin-bottom: var(--space-1);"><%= plan.name %></h3>
              <p style="font-size: var(--font-size-xs); color: var(--text-muted); min-height: 36px;"><%= plan.description %></p>
              
              <div style="margin: var(--space-4) 0; font-size: var(--font-size-3xl); font-weight: 800; color: var(--text-primary);">
                $<%= plan.price %>
                <span style="font-size: var(--font-size-sm); color: var(--text-muted); font-weight: 400;">/ <%= plan.durationInDays %> days</span>
              </div>

              <ul style="margin-bottom: var(--space-6); flex: 1; display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--font-size-sm); color: var(--text-secondary);">
                <% if (plan.features && plan.features.length > 0) { %>
                  <% plan.features.forEach(feat => { %>
                    <li class="flex items-center gap-2">
                      <svg style="width: 16px; height: 16px; color: var(--accent-primary); flex-shrink: 0;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span><%= feat %></span>
                    </li>
                  <% }) %>
                <% } else { %>
                  <li class="flex items-center gap-2">Full Gym Equipment Access</li>
                  <li class="flex items-center gap-2">Daily Attendance Logging</li>
                  <li class="flex items-center gap-2">Fitness Intelligence Reports</li>
                <% } %>
              </ul>

              <a href="/auth/register" class="btn btn-primary btn-block">Choose Plan</a>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer style="padding: var(--space-8) 0; border-top: 1px solid var(--border-subtle); background-color: var(--bg-secondary); font-size: var(--font-size-xs); color: var(--text-muted); text-align: center;">
    <div class="container">
      <p>GYMFLOW &copy; 2026. Production Gym Membership, Workout Planning & Fitness Intelligence Platform.</p>
    </div>
  </footer>
</body>
</html>
